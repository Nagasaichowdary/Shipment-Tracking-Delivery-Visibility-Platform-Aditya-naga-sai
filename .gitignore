# ── Secrets / environment variables ─────────────────────────────────────────
# Never commit credential files. These are loaded locally via spring-dotenv
# (backend) or Vite env resolution (frontend).
backend/.env
backend/.env.*
# Note: frontend_final/.env is already tracked in git (contains only the
# Maps API key). Use Render build-time env vars for VITE_API_BASE_URL.

# ── Generated logs ───────────────────────────────────────────────────────────
*.log
*.log.err
backend/*.log
backend/*.log.err

# ── Build artefacts ──────────────────────────────────────────────────────────
backend/target/
frontend_final/dist/
frontend_final/node_modules/

# ── OS / editor noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.iml